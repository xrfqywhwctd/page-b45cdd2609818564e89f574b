argin-bottom: 12px}\n\n    .closing p {margin: 0;max-width: 52ch;font-size: 0.98rem}\n\n    .closing .stamp {justify-self: end;border: 2px solid var(--ink);padding: 18px 22px;font-family: var(--mono);font-size: 0.76rem;letter-spacing: 0.06em;line-height: 1.8;min-width: 230px;background: transparent}\n\n    .closing .stamp strong {display: block;font-size: 1.1rem;letter-spacing: 0.02em;margin-bottom: 2px}\n\n    footer {padding: 32px 0 44px;background: var(--ink);border-top: 1px solid var(--line);font-size: 0.8rem;color: var(--muted)}\n\n    footer .wrap {display: flex;flex-wrap: wrap;justify-content: space-between;gap: 12px 28px;align-items: baseline}\n\n    footer a {color: var(--paper-dim);border-bottom: 1px solid transparent}\n\n    footer a:hover {color: var(--acid);border-bottom-color: var(--acid)}\n\n    @media (max-width: 900px) {\n      .hero .wrap {grid-template-columns: 1fr;gap: 44px}\n\n      .hero-panel {max-width: 460px}\n\n      .why-grid {grid-template-columns: 1fr 1fr}\n\n      .why-item:not(:nth-child(3n)) {border-right: 0;padding-right: 0}\n\n      .why-item:not(:nth-child(3n+1)) {padding-left: 32px}\n\n      .why-item:nth-child(odd) {border-right: 1px solid var(--line);padding-right: 32px}\n\n      .why-item:nth-child(even) {border-right: 0;padding-left: 32px}\n\n      .section-head {grid-template-columns: 1fr;gap: 18px;margin-bottom: 34px}\n\n      .step {grid-template-columns: 64px minmax(0, 1fr);gap: 20px}\n\n      .step p {grid-column: 2;margin-top: 8px}\n\n      .closing .wrap {grid-template-columns: 1fr;gap: 28px}\n\n      .closing .stamp {justify-self: start}\n    }\n\n    @media (max-width: 620px) {\n      .wrap {width: min(1120px, calc(100% - 28px))}\n\n      .breadcrumb-nav .wrap {flex-direction: column;align-items: flex-start}\n\n      .hero {padding: 48px 0 56px}\n\n      .why-grid {grid-template-columns: 1fr}\n\n      .why-item,\n      .why-item:nth-child(odd),\n      .why-item:nth-child(even),\n      .why-item:not(:nth-child(3n)) {border-right: 0;padding: 26px 0 44px}\n\n      .why-item .big-num {font-size: 4rem;bottom: -10px;right: 0}\n\n      .client-grid,\n      .faq-grid {grid-template-columns: 1fr}\n\n      .step {grid-template-columns: 1fr;gap: 8px;padding: 22px 0}\n\n      .step p {grid-column: auto}\n\n      .step-num {font-size: 1.4rem}\n\n      .hero-meta {gap: 8px 18px}\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      html {}\n    }\n  </style><nav class=\"breadcrumb-nav\" aria-label=\"页面顶部面包屑与目录\">\n    <div class=\"wrap\">\n      <ol class=\"crumbs\">\n        <li><a href=\"#\">首页</a></li>\n        <li><a href=\"#plans\">套餐</a></li>\n        <li>服务说明</li>\n      </ol>\n      <ul class=\"directory\">\n        <li><a href=\"#why\">为什么读这份说明</a></li>\n        <li><a href=\"#plans\">套餐对比</a></li>\n        <li><a href=\"#clients\">客户端</a></li>\n        <li><a href=\"#howto\">使用步骤</a></li>\n        <li><a href=\"#faq\">常见问题</a></li>\n      </ul>\n    </div>\n  </nav>\n\n  <main>\n    <header class=\"hero\">\n      <div class=\"wrap\">\n        <div class=\"hero-copy\">\n          <p class=\"eyebrow\">SpeedOnline · 服务说明页</p>\n          <h1>先把 <span class=\"mark\">SpeedOnline</span> 当一份说明书读</h1>\n          <p class=\"hero-lead\">\n            你大概在找一个答案：<strong>这套服务是否适合我的上网方式？</strong>\n            这页不写豪言壮语。我们按问答的方式，把套餐差别、客户端适用场景和常见疑问逐条展开，\n            便于你在决定之前把细节看清楚。\n          </p>\n          <div class=\"hero-meta\">\n            <span><i class=\"dot\"></i> 价格与权益以本页表格为准</span>\n            <span><i class=\"dot\"></i> 未提供的服务不作额外承诺</span>\n          </div>\n        </div>\n\n        <aside class=\"hero-panel\" aria-label=\"快速导读\">\n          <h2>先看三件事</h2>\n          <ul class=\"quick-list\">\n            <li>\n              <span class=\"n\">01</span>\n              <span><b>套餐按月与按年标注</b>，按年价单独列出，方便比较长期成本。</span>\n            </li>\n            <li>\n              <span class=\"n\">02</span>\n              <span><b>设备数量写进表格</b>，家庭与团队场景分开判断。</span>\n            </li>\n            <li>\n              <span class=\"n\">03</span>\n              <span><b>客户端以实际用途划分</b>，不堆砌平台名称。</span>\n            </li>\n          </ul>\n        </aside>\n      </div>\n    </header>\n\n    <section id=\"why\" class=\"section-light\">\n      <div class=\"wrap\">\n        <div class=\"section-head\">\n          <h2 id=\"why-title\">为什么这份说明按问题来写？<span class=\"accent\"></span></h2>\n          <p class=\"muted\">因为购买前的犹豫，通常不是缺宣传语，而是缺一个能对号入座的答案。我们把信息做成可查的条目。</p>\n        </div>\n\n        <div class=\"why-grid\">\n          <article class=\"why-item\">\n            <h3>先说清楚再选</h3>\n            <p>流量、设备数、价格周期放在同一张表里，避免在多个页面之间来回对照。</p>\n            <span class=\"big-num\">01</span>\n          </article>\n          <article class=\"why-item\">\n            <h3>不替你假设场景</h3>\n            <p>个人使用、家庭共享、团队协作的需求不同，表格里分别给出对应参考。</p>\n            <span class=\"big-num\">02</span>\n          </article>\n          <article class=\"why-item\">\n            <h3>只写已给出的信息</h3>\n            <p>没有可靠来源的性能数字、节点数量和下载地址，就不作为卖点写入页面。</p>\n            <span class=\"big-num\">03</span>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"plans\">\n      <div class=\"wrap\">\n        <div class=\"section-head\">\n          <h2 id=\"plans-title\">套餐对比：横向看差别，纵向看自己</h2>\n          <p>三档方案按流量与设备数递进。价格、按年价和权益均直接列在表格中，便于逐行比较。</p>\n        </div>\n\n        <div class=\"table-wrap\">\n          <table>\n            SpeedOnline 套餐权益对比（价格与权益以本表为准）\n            <thead>\n              <tr>\n                <th>对比项</th>\n                <th>\n                  <span class=\"plan-name\">基础版</span>\n                  <span class=\"plan-price\">¥15/月</span>\n                  <span class=\"plan-note\">按年付 ¥150/年</span>\n                </th>\n                <th>\n                  <span class=\"plan-name\">旗舰版 <span class=\"recommend\">推荐</span></span>\n                  <span class=\"plan-price\">¥35/月</span>\n                  <span class=\"plan-note\">按年付 ¥350/年</span>\n                </th>\n                <th>\n                  <span class=\"plan-name\">团队版</span>\n                  <span class=\"plan-price\">¥85/月</span>\n                  <span class=\"plan-note\">按年付 ¥850/年</span>\n                </th>\n              </tr>\n            </thead>\n            <tbody>\n              <tr>\n                <th>每月流量</th>\n                <td>100GB</td>\n                <td>300GB</td>\n                <td>1000GB</td>\n              </tr>\n              <tr>\n                <th>同时在线设备</th>\n                <td>3 台</td>\n                <td>5 台</td>\n                <td>20 台</td>\n              </tr>\n              <tr>\n                <th>线路说明</th>\n                <td>普通线路节点池</td>\n                <td>全节点原生流媒体解锁</td>\n                <td>VIP 专属高带宽节点</td>\n              </tr>\n              <tr>\n                <th>附加权益</th>\n                <td>解锁基础流媒体</td>\n                <td>IPLC 专线游戏加速优化</td>\n                <td>支持企业定制路由</td>\n              </tr>\n              <tr>\n                <th>支持方式</th>\n                <td>常规工单支持</td>\n                <td>7×24 优先工单支持</td>\n                <td>专属客户经理服务</td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n        <p class=\"table-footnote\">\n          说明：表中“解锁”“专线”“加速”等描述仅对应套餐权益名称，不构成对具体地区、节点数量或速度数值的额外承诺。按年付金额为对应年度周期的合计价格。\n        </p>\n      </div>\n    </section>\n\n    <section id=\"clients\" class=\"section-light\">\n      <div class=\"wrap\">\n        <div class=\"section-head\">\n          <h2 id=\"clients-title\" class=\"muted\">客户端：按使用方式区分</h2>\n          <p class=\"muted\">不列出未经确认的下载链接，只说明各类客户端通常对应怎样的使用习惯，便于你判断入口。</p>\n        </div>\n\n        <div class=\"client-grid\">\n          <article class=\"client-card\">\n            <h3>桌面端客户端</h3>\n            <p>适合长时间在电脑前工作的人。安装后按引导填写账号信息，日常切换线路的操作多在托盘或菜单栏完成。</p>\n            <span class=\"client-tag\">桌面场景</span>\n            <span class=\"big-num\">A</span>\n          </article>\n          <article class=\"client-card\">\n            <h3>移动端客户端</h3>\n            <p>适合手机与平板为主的用户。安装包以客户端内提供的说明为准，配置方式与桌面端一致，操作路径更短。</p>\n            <span class=\"client-tag\">移动场景</span>\n            <span class=\"big-num\">B</span>\n          </article>\n          <article class=\"client-card\">\n            <h3>多设备共享场景</h3>\n            <p>在流量和设备数允许的范围内，可同时用于家庭或个人多终端。超出套餐设备数量时，需要按档位选择更高方案。</p>\n            <span class=\"client-tag\">家庭 / 个人</span>\n            <span class=\"big-num\">C</span>\n          </article>\n          <article class=\"client-card\">\n            <h3>团队接入场景</h3>\n            <p>团队版面向多人协作。企业定制路由等选项按套餐权益执行，具体配置需与对接人员按实际网络结构确认。</p>\n            <span class=\"client-tag\">团队场景</span>\n            <span class=\"big-num\">D</span>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"howto\">\n      <div class=\"wrap\">\n        <div class=\"section-head\">\n          <h2 id=\"howto-title\">使用步骤：从阅读到接入</h2>\n          <p>按顺序走，不必跳步。每一步都对应页面上的一个信息源，方便回查。</p>\n        </div>\n\n        <div class=\"steps\">\n          <article class=\"step\">\n            <div class=\"step-num\">01</div>\n            <h3>确认自己的用量与设备数</h3>\n            <p>先看每月大致流量和需要在线的设备数量，再回到套餐表逐行比对，优先排除设备数不足的档位。</p>\n          </article>\n          <article class=\"step\">\n            <div class=\"step-num\">02</div>\n            <h3>选择按月或按年</h3>\n            <p>按月付灵活，按年付在表格中单独标出合计金额。你可以按自己的使用周期判断，而不是被默认选项推着走。</p>\n          </article>\n          <article class=\"step\">\n            <div class=\"step-num\">03</div>\n            <h3>在对应客户端完成接入</h3>\n            <p>选择与你设备匹配的客户端类型，按客户端内说明填写账号与配置信息。页面不提供未确认的下载地址。</p>\n          </article>\n          <article class=\"step\">\n            <div class=\"step-num\">04</div>\n            <h3>遇到问题时先查 FAQ，再联系支持</h3>\n            <p>常见问题覆盖计费、设备数、线路与支持渠道。若仍未解决，可通过套餐对应工单渠道提交。</p>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"faq\" class=\"section-light\">\n      <div class=\"wrap\">\n        <div class=\"section-head\">\n          <h2 id=\"faq-title\" class=\"muted\">常见问题：两条一列，方便对照</h2>\n          <p class=\"muted\">以下是购买与使用前被问得最多的问题，答案尽量具体。信息以本页套餐表和说明为准。</p>\n        </div>\n\n        <div class=\"faq-grid\">\n          <article class=\"faq-item\">\n            <h3><span class=\"q\">Q1</span> 按月付和按年付有什么区别？</h3>\n            <p>套餐表分别列出了月费和按年付合计金额。按年付适合确定会使用一年左右的人；按月付更灵活，适合先观察一段时间。</p>\n          </article>\n          <article class=\"faq-item\">\n            <h3><span class=\"q\">Q2</span> 设备数量超出套餐会怎样？</h3>\n            <p>同时在线设备数由套餐决定。超过上限时，需要升级到更高档位，或减少同时连接的设备数量。基础版 3 台、旗舰版 5 台、团队版 20 台。</p>\n          </article>\n          <article class=\"faq-item\">\n            <h3><span class=\"q\">Q3</span> 页面没有下载地址，我先从哪里开始？</h3>\n            <p>本页只做说明，不提供未经确认的下载链接。你可以先按客户端类型确认设备场景，再通过套餐对应渠道获取客户端入口与配置说明。</p>\n          </article>\n          <article class=\"faq-item\">\n            <h3><span class=\"q\">Q4</span> 旗舰版的“IPLC 专线游戏加速优化”指什么？</h3>\n            <p>这是套餐权益名称。页面不对具体地区、延迟数值或游戏列表作额外承诺。如果你的用途对线路要求较高，建议先确认该权益是否覆盖你的目标场景。</p>\n          </article>\n          <article class=\"faq-item\">\n            <h3><span class=\"q\">Q5</span> 团队版可以给多少成员使用？</h3>\n            <p>团队版列出的是 20 台设备同时在线，以及 1000GB 月流量和 VIP 专属高带宽节点等权益。具体人员分配与定制路由需求，需要按实际情况说明。</p>\n          </article>\n          <article class=\"faq-item\">\n            <h3><span class=\"q\">Q6</span> 遇到问题找谁？</h3>\n            <p>按套餐对应支持渠道：基础版为常规工单，旗舰版为 7×24 优先工单，团队版为专属客户经理服务。建议先阅读本页 FAQ 与套餐表，再提交问题。</p>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"closing\">\n      <div class=\"wrap\">\n        <div>\n          <h2 id=\"closing-title\">读到这里，再决定要不要选 SpeedOnline</h2>\n          <p>如果表格里的流量、设备数和价格区间与你的使用方式吻合，下一步就是选择按月或按年、确认客户端类型。若不吻合，这页也足够帮你排除不合适的选择。</p>\n        </div>\n        <div class=\"stamp\" aria-label=\"页面摘要\">\n          <strong>SpeedOnline 摘要</strong>\n          三档套餐 · 横向对比<br>\n          价格与按年付分别列示<br>\n          客户端按场景分类<br>\n          常见问题双栏呈现\n        </div>\n      </div>\n    </section>\n  </main>\n\n  <footer>\n    <div class=\"wrap\">\n      <span>SpeedOnline · 服务说明页。页面信息以本页套餐表与 FAQ 为准。</span>\n      <span><a href=\"#plans\">回到套餐对比</a> · <a href=\"#faq\">查看常见问题</a></span>\n    </div>\n  </footer>",
